#!name = 约牛 Token 自动获取
#!desc = 自动抓取 touguapi.zx093.com 请求头中的 centraltoken 并持久化到本地本地变量 yueniu 中。
#!author = AI Collaborator
#!homepage = https://github.com/ajune0527/proxy-script
#!icon = https://raw.githubusercontent.com/luestr/Icon-set/main/App_icon/120px/Netease.png
#!date = 2026-06-09

[Script]
# 新版 Script 语法（Loon 3.5.1 983+）：在请求头阶段读取 centraltoken
request if ${url} ~= /^https:\/\/touguapi\.zx093\.com/i then script("https://raw.githubusercontent.com/ajune0527/proxy-script/main/js/yueniu.js") with tag="获取约牛Token", debug=true

[Mitm]
hostname = touguapi.zx093.com
