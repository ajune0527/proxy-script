#!name= 致富运营位净化
#!desc= 过滤致富APP运营位（Banner）响应中的推广/营销项目。按 slotConfig.nameSc 过滤，每个运营位独立开关，支持自定义关键字。
#!author= ajune
#!system= iOS
#!tag= 去广告
#!loon_version= 3.2.1(733)
#!icon= https://raw.githubusercontent.com/ajune0527/proxy-script/main/chief.png
#!homepage= https://github.com/ajune0527/proxy-script
#!date= 2026-09-18

[Argument]
Banner过滤 = switch,true,tag=Banner过滤,desc=关闭后不过滤任何运营位
首页Banner-新版 = switch,true,tag=首页Banner-新版,desc=过滤运营位「首页Banner-新版」
活动中心 = switch,true,tag=活动中心,desc=过滤运营位「活动中心」
致富证券POPUP弹窗 = switch,true,tag=致富证券POPUP弹窗,desc=过滤运营位「致富证券POPUP弹窗」
致富通IPO-Banner = switch,true,tag=致富通IPO-Banner,desc=过滤运营位「致富通IPO Banner」
SEM-IPO页表单 = switch,true,tag=SEM-IPO页表单,desc=过滤运营位「SEM-IPO页表单」
搜索页运营位 = switch,true,tag=搜索页运营位,desc=过滤运营位「搜索页运营位」
个股页跑马灯 = switch,false,tag=个股页跑马灯,desc=过滤运营位「个股页跑马灯」
未开户首页 = switch,false,tag=未开户首页,desc=过滤运营位「未开户首页」
首页公告 = switch,false,tag=首页公告,desc=过滤运营位「首页公告」，该运营位可能含重要公告，默认保留
Banner自定义过滤 = input, "自定义过滤关键字，多个用逗号分隔（匹配运营位名称 nameSc 或条目名称 lable / 标题）", tag=Banner自定义过滤,desc=自定义过滤关键字，多个用逗号分隔，匹配 nameSc / lable / 标题


[script]
http-response ^https?://(api2\.)?(cg1979|chieftrader1979|toptrader1979|zft2000|zft2025|cm-chiefgroup|chiefgroup)\.(com|com\.hk)/chief-operations/(api/v1/ops/slot/config|api/v1/banner/get) script-path=https://raw.githubusercontent.com/ajune0527/proxy-script/main/js/chief-banner-filter.js, requires-body=true, tag=致富-运营位过滤, argument=[{Banner过滤},{首页Banner-新版},{活动中心},{致富证券POPUP弹窗},{致富通IPO-Banner},{SEM-IPO页表单},{搜索页运营位},{个股页跑马灯},{未开户首页},{首页公告},{Banner自定义过滤}]

[mitm]
hostname = %APPEND% api2.cg1979.com, api2.chieftrader1979.com, api2.toptrader1979.com, api2.zft2000.com, api2.zft2025.com, api2.chiefgroup.com.hk, api2.cm-chiefgroup.com, cm-chiefgroup.com, chieftrader1979.com, chiefgroup.com.hk, zft2025.com, zft2000.com, cg1979.com, toptrader1979.com
